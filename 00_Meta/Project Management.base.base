views:
  - type: table
    name: All Goals
    filters:
      and:
        - type.contains("Goal")
    sort: []
  - type: table
    name: All Projects
    filters:
      and:
        - type.contains("Project")
  - type: table
    name: All Team Members
    filters:
      and:
        - type.contains("Team")
  - type: table
    name: All Projects Charters
    filters:
      and:
        - type.contains("Project Charter")
        - '!file.name.contains("(AI)")'
  - type: table
    name: All Work Packages
    filters:
      and:
        - type.contains("Work Package")
  - type: table
    name: All Requirements
    filters:
      and:
        - type.contains("Requirement")
  - type: table
    name: All Work Packages (Timing)
    filters:
      and:
        - type.contains("Work Package")
    order:
      - duration_days
      - lead_time_days
      - estimated_effort
      - owner
      - status
  - type: table
    name: All Work Packages (PERT)
    filters:
      and:
        - type.contains("Work Package")
    order:
      - duration_days
      - lead_time_days
      - estimated_effort
      - owner
      - status
      - pert_optimistic
      - pert_likely
      - pert_pessimistic
      - pert_estimated_effort
      - pert_sigma
