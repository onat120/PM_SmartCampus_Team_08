views:
  - type: table
    name: All Properties
  - type: table
    name: All Projects
    filters:
      and:
        - type.contains("Project")
  - type: table
    name: All Team Members
    filters:
      and:
        - type.contains("Team")
  - type: table
    name: All Projects Charters
    filters:
      and:
        - type.contains("Project Charter")
        - '!file.name.contains("(AI)")'
