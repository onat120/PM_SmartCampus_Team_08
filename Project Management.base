views:
  - type: table
    name: Sicht
  - type: table
    name: All Work Packages (PERT)
    filters:
      and:
        - type.contains("Work Package")
  - type: table
    name: All Work Packages
    filters:
      and:
        - type.contains("Work Package")
  - type: table
    name: All Requirements
    filters:
      and:
        - type.contains("Requirement")
  - type: table
    name: All Goals
    filters:
      and:
        - type.contains("Goal")
  - type: table
    name: All Projects Charters
    filters:
      and:
        - type == ["Project Charter"]
  - type: table
    name: All Team Members
    filters:
      and:
        - type.contains("Team")
    order:
      - file.name
